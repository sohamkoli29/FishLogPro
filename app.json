{
  "expo": {
    "name": "FishLog Pro",
    "slug": "fishlog-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf9f4"
    },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.fishlogpro.app" },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fbf9f4"
      },
      "package": "com.fishlogpro.app"
    },
    "plugins": ["expo-sqlite", "expo-print", "expo-file-system"]
  }
}